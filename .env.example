####################################
# AUT (Agent Under Test)
####################################

AUT_PROVIDER=anthropic
AUT_MODEL=claude-sonnet-5
AUT_API_KEY=
AUT_BASE_URL=
# AUT_TIMEOUT=60   # seconds per call; raise for a local/slow provider (see Ollama note below)

####################################
# JUDGE
####################################

JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5
JUDGE_API_KEY=
JUDGE_BASE_URL=
# JUDGE_TIMEOUT=60   # seconds per call; raise for a local/slow provider (see Ollama note below)

####################################
# MYSQL
####################################

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agentaudit
MYSQL_USER=agentaudit
MYSQL_PASSWORD=password

####################################
# APP
####################################

HOST=0.0.0.0
PORT=8000
DEBUG=true
SECRET_KEY=change-me-in-production

# Docker Compose only: the HOST port the backend container is published on (the container
# always listens on 8000 internally, regardless of this value). Override if 8000 is already
# taken on your machine by another application; leave unset to keep the default.
# BACKEND_PORT=8000

####################################
# EVALUATION
####################################

ENABLE_BEHAVIOUR_CLASSIFICATION=true
ENABLE_FAILURE_ATTRIBUTION=true
ENABLE_CONFIDENCE_SCORING=true
ENABLE_REASONING_STORAGE=true
ENABLE_EXECUTION_TRACE=true

####################################
# LOGGING
####################################

LOG_LEVEL=INFO

####################################
# LOCAL/DEV OVERRIDE (optional)
####################################
# Full SQLAlchemy async DSN override, e.g. for SQLite in local dev or CI unit tests.
# When unset, the MYSQL_* variables above are used to build the DSN (MySQL 8+ is primary
# per PROJECT_SPEC_1 SS74; SQLite is development-only).
# DATABASE_URL=sqlite+aiosqlite:///./agentaudit.db

####################################
# Per-provider AUT/JUDGE examples (reference only -- uncomment ONE AUT_* group and
# ONE JUDGE_* group above with your own keys; never commit real keys to this file)
####################################

# AUT_PROVIDER=openai
# AUT_MODEL=gpt-5
# AUT_API_KEY=your-openai-api-key
# AUT_BASE_URL=https://api.openai.com/v1

# AUT_PROVIDER=anthropic
# AUT_MODEL=claude-sonnet-5
# AUT_API_KEY=your-anthropic-api-key
# AUT_BASE_URL=https://api.anthropic.com

# AUT_PROVIDER=gemini
# AUT_MODEL=gemini-2.5-pro
# AUT_API_KEY=your-gemini-api-key
# AUT_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# AUT_PROVIDER=deepseek
# AUT_MODEL=deepseek-chat
# AUT_API_KEY=your-deepseek-api-key
# AUT_BASE_URL=https://api.deepseek.com

# AUT_PROVIDER=groq
# AUT_MODEL=llama-3.3-70b-versatile
# AUT_API_KEY=your-groq-api-key
# AUT_BASE_URL=https://api.groq.com/openai/v1

# AUT_PROVIDER=sarvam
# AUT_MODEL=sarvam-105b
# AUT_API_KEY=your-sarvam-api-key
# AUT_BASE_URL=https://api.sarvam.ai/v1

# Ollama base URL depends on how AgentAudit itself is running:
#   - `uvicorn app.main:app` directly on your host -> http://localhost:11434
#   - `docker compose up` (backend runs inside a container, so "localhost" means the
#     container itself, not your machine) -> http://host.docker.internal:11434
# Getting this wrong looks like a connection/timeout error, not an auth error -- Ollama needs no
# real API key (AUT_API_KEY/JUDGE_API_KEY can be any non-empty placeholder, e.g. "ollama").
# Also raise AUT_TIMEOUT/JUDGE_TIMEOUT well above the 60s default (e.g. 300) for local CPU
# inference -- a single evaluator call regularly takes longer than that.
# AUT_PROVIDER=ollama
# AUT_MODEL=llama3.2
# AUT_API_KEY=ollama
# AUT_BASE_URL=http://localhost:11434

# JUDGE_PROVIDER=sarvam
# JUDGE_MODEL=sarvam-105b
# JUDGE_API_KEY=your-sarvam-api-key
# JUDGE_BASE_URL=https://api.sarvam.ai/v1

# JUDGE_PROVIDER=ollama
# JUDGE_MODEL=llama3.2
# JUDGE_API_KEY=ollama
# JUDGE_BASE_URL=http://localhost:11434
# JUDGE_TIMEOUT=300
